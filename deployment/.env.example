# Non-secret configuration only. Copy outside the checkout on the VM.
APPLICATION_IMAGE=service-advertiser:replace-with-source-revision
SITE_ADDRESS=api.example.com
DEPLOYMENT_SECRETS_DIR=/etc/service-advertiser/secrets
DEPLOYMENT_DB_NAME=service_advertiser
DEPLOYMENT_DB_USER=service_advertiser
DEPLOYMENT_DATABASE_URL=jdbc:postgresql://postgres:5432/service_advertiser
# Change all three together if this subnet conflicts with an existing network.
DEPLOYMENT_INGRESS_SUBNET=10.203.80.0/24
CADDY_INGRESS_ADDRESS=10.203.80.254
TRUSTED_PROXY_REGEX=10\.203\.80\.254
